{
  "name": "@anto-project/discord-bot-core",
  "version": "0.1.0",
  "private": true,
  "description": "Domain-neutral Discord communication, payload-safety and runtime primitives for Anto-Project bots.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/discordjs.d.ts",
      "default": "./dist/discordjs.js"
    },
    "./localization": {
      "types": "./dist/localization/index.d.ts",
      "default": "./dist/localization/index.js"
    },
    "./presentation": {
      "types": "./dist/presentation/index.d.ts",
      "default": "./dist/presentation/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "default": "./dist/observability/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./node-storage": {
      "types": "./dist/node-storage.d.ts",
      "default": "./dist/node-storage.js"
    }
  },
  "files": [
    "dist",
    "src",
    "vendor/dynamic-embed-engine/dist",
    "vendor/dynamic-embed-engine/package.json",
    "vendor/dynamic-embed-engine/README.md",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anto426-Project/discord-bot-core.git"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "scripts": {
    "clean": "node --eval \"import('node:fs').then(({rmSync}) => rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run test",
    "package:smoke": "node scripts/package-smoke.mjs",
    "ci": "npm run check && npm run package:smoke",
    "prepack": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.9",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "license": "UNLICENSED"
}
